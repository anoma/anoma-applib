module Anoma.Builtin.ByteArray;

import Stdlib.Prelude open;
import Stdlib.Debug.Trace open;
import Stdlib.Debug.Fail open;
import BaseLayer.AnomaAtom open;
import Stdlib.Trait.Ord.Eq open using {fromOrdToEq};
import Anoma.Data.Json open;
import Mtl open;
import Anoma.Primitives.FixedSize open;

module ByteArray;
  builtin bytearray
  axiom ByteArray : Type;

  builtin bytearray-from-list-byte
  axiom mk : List Byte -> ByteArray;

  fromList : List Byte -> ByteArray := mk;

  empty : ByteArray := fromList [];

  toList (b : ByteArray) : List Byte :=
    let
      go (acc : List Byte) (payload : Nat) : (len : Nat) -> List Byte
        | zero := reverse acc
        -- Note `fromNat` takes the modulo
        | (suc ibyte) := go (fromNat payload :: acc) (div payload 256) ibyte;
    in go [] (rawToAnomaContents b) (size b);

  zero (length : Nat) : ByteArray := mk (replicate length 0x0);

  --- The number of bytes in the ;ByteArray;
  builtin bytearray-length
  axiom size : ByteArray -> Nat;

  builtin anoma-bytearray-to-anoma-contents
  axiom rawToAnomaContents : ByteArray -> Nat;

  toAnomaContents : ByteArray -> AnomaAtom :=
    rawToAnomaContents >> AnomaAtom.fromNat;

  builtin anoma-bytearray-from-anoma-contents
  axiom rawFromAnomaContents (size : Nat) (contents : Nat) : ByteArray;

  fromAnomaContents (size : Nat) (contents : AnomaAtom) : ByteArray :=
    rawFromAnomaContents@{
      size;
      contents := AnomaAtom.toNat contents;
    };

  instance
  ByteArray-Show : Show ByteArray :=
    Show.mk@{
      show : ByteArray -> String := toList >> Show.show;
    };

  instance
  ByteArray-ToJson : ToJson ByteArray :=
    ToJson.mk@{
      toJson (b : ByteArray) : Json := Json.number (rawToAnomaContents b);
    };
end;

open ByteArray using {ByteArray; fromAnomaContents; toAnomaContents} public;

instance
ByteArray-Ord : Ord ByteArray :=
  let
    prod (b : ByteArray) : _ := ByteArray.size b, toAnomaContents b;
  in Ord.mk@{
       compare (lhs rhs : ByteArray) : Ordering :=
         Ord.compare (prod lhs) (prod rhs);
     };

instance
ByteArray-Eq : Eq ByteArray := fromOrdToEq;

execState
  {S A : Type}
  {M : Type → Type}
  {{Functor M}}
  (s : S)
  (m : StateT S M A)
  : M S := Functor.map snd (runState s m);

--- The byte length of all encodings must be a multiple of 32
evmAlign : Nat := 32;

type BytesBuilder (A : Type) :=
  mk@{
    unwrap : StateT BytesBuilder.Builder Identity A;
  }
with
  type Builder : Type :=
    mk@{
      bytes : List Byte;
      size : Nat;
    }
  with
    cons (b : Byte) (s : BytesBuilder.Builder) : BytesBuilder.Builder :=
      s@BytesBuilder.Builder{
        bytes := b :: bytes s;
        size := 1 + size s;
      };

    replicate
      (n : Nat) (b : Byte) (s : BytesBuilder.Builder) : BytesBuilder.Builder :=
      s@BytesBuilder.Builder{
        bytes := Stdlib.Prelude.replicate n b ++ bytes s;
        size := n + size s;
      };

    -- TODO efficient concatenation
    append (b1 b2 : BytesBuilder.Builder) : BytesBuilder.Builder :=
      BytesBuilder.Builder.mk@{
        bytes := bytes b2 ++ bytes b1;
        size := size b1 + size b2;
      };

    toByteArray (s : BytesBuilder.Builder) : ByteArray :=
      ByteArray.mk (reverse (bytes s));

    empty : Builder :=
      BytesBuilder.Builder.mk@{
        bytes := [];
        size := 0;
      };
  end;

  run {A} : BytesBuilder A -> ByteArray := runBuilder >> Builder.toByteArray;

  runWith {A} (ini : Builder) : BytesBuilder A -> Builder
    | (mk st) := Identity.run (execState ini st);

  runBuilder {A} : BytesBuilder A -> Builder := runWith Builder.empty;

  --- append a byte
  byte (b : Byte) : BytesBuilder Unit := mk (modify (Builder.cons b));

  pad (n : Nat) : BytesBuilder Unit := replicate n 0;

  replicate (n : Nat) (b : Byte) : BytesBuilder Unit :=
    mk (modify (Builder.replicate n b));

  builder (b : BytesBuilder.Builder) : BytesBuilder Unit :=
    mk (modify \{acc := Builder.append acc b});

  --- get the current size
  size : BytesBuilder Nat := mk (BytesBuilder.Builder.size <$> get);

  instance
  BytesBuilder-Functor : Functor BytesBuilder :=
    Functor.mk@{
      map {A} {B} (f : A -> B) : BytesBuilder A -> BytesBuilder B
        | (mk p) := mk (Functor.map f p);
    };

  instance
  BytesBuilder-Applicative : Applicative BytesBuilder :=
    Applicative.mk@{
      pure {A} (a : A) : BytesBuilder A := mk (Applicative.pure a);
      ap {A} {B} : BytesBuilder (A -> B) -> BytesBuilder A -> BytesBuilder B
        | (mk f) (mk p) := mk (Applicative.ap f p);
    };

  instance
  BytesBuilder-Monad : Monad BytesBuilder :=
    Monad.mk@{
      bind {A} {B} : BytesBuilder A -> (A -> BytesBuilder B) -> BytesBuilder B
        | (mk x) m :=
          mk
            do {
              a <- x;
              BytesBuilder.unwrap (m a);
            };
    };
end;

type BytesConsumer A :=
  mk@{
    unwrap : StateT (List Byte) (ErrorT BytesConsumer.ConsumerError Identity) A;
  }
with
  type ConsumerError := mk String
  with
    instance
    ConsumerError-Show : Show ConsumerError :=
      Show.mk \{(ConsumerError.mk err) := err};
  end;

  run {A} : BytesConsumer A -> ByteArray -> Result ConsumerError A
    | (mk p) str :=
      Identity.run (runError (evalState (ByteArray.toList str) p));

  local {A} : BytesConsumer A -> List Byte -> BytesConsumer A
    | (mk m) bytes :=
      mk
        do {
          old <- get {List Byte};
          put bytes;
          res <- m;
          put old;
          pure res;
        };

  instance
  BytesConsumer-Functor : Functor BytesConsumer :=
    Functor.mk@{
      map {A} {B} (f : A -> B) : BytesConsumer A -> BytesConsumer B
        | (mk p) := mk (Functor.map f p);
    };

  instance
  BytesConsumer-Applicative : Applicative BytesConsumer :=
    Applicative.mk@{
      pure {A} (a : A) : BytesConsumer A := mk (Applicative.pure a);
      ap {A} {B} : BytesConsumer (A -> B) -> BytesConsumer A -> BytesConsumer B
        | (mk f) (mk p) := mk (Applicative.ap f p);
    };

  instance
  BytesConsumer-Monad : Monad BytesConsumer :=
    Monad.mk@{
      bind
        {A} {B} : BytesConsumer A -> (A -> BytesConsumer B) -> BytesConsumer B
        | (mk x) m :=
          mk
            do {
              a <- x;
              BytesConsumer.unwrap (m a);
            };
    };

  byte : BytesConsumer Byte :=
    mk
      do {
        l <- get;
        case l of {
          | [] := throw (ConsumerError.mk "end of input")
          | x :: xs :=
            do {
              put xs;
              pure x;
            }
        };
      };
end;

trait
type FromBytes (T : Type) :=
  mk@{
    fromBytes : BytesConsumer T;
  }
with
  -- Big endian
  WordN {A} {{FromNatural A}} : FromBytes A :=
    let
      go (acc : Nat) : (numByte : Nat) -> BytesConsumer A
        | zero := pure (fromNat acc)
        | (suc ibyte) :=
          do {
            bi <- Byte.toNat <$> BytesConsumer.byte;
            go (acc + bi * pow 256 ibyte) ibyte;
          };
    in FromBytes.mk (go 0 evmAlign);
end;

open FromBytes using {fromBytes} public;

trait
type ToBytes (T : Type) :=
  mk@{
    toBytes : T -> BytesBuilder Unit;
  }
with
  -- Big endian
  WordN {A} (toNat : A -> Nat) : ToBytes A :=
    let
      go (n : Nat) : (numByte : Nat) -> BytesBuilder Unit
        | zero := pure unit
        | (suc ibyte) :=
          do {
            BytesBuilder.byte (FromNatural.fromNat (div n (pow 256 ibyte)));
            go n ibyte;
          };
    in ToBytes.mk \{n := go (toNat n) evmAlign};
end;

open ToBytes using {toBytes} public;

toByteArray {A} {{ToBytes A}} (a : A) : ByteArray :=
  BytesBuilder.run (toBytes a);

fromByteArray
  {A} {{FromBytes A}} (a : ByteArray) : Result BytesConsumer.ConsumerError A :=
  BytesConsumer.run fromBytes a;

instance
Byte-FromBytes : FromBytes Byte :=
  FromBytes.mk@{
    fromBytes := BytesConsumer.byte;
  };

instance
Byte-ToBytes : ToBytes Byte :=
  ToBytes.mk@{
    toBytes (b : Byte) : BytesBuilder Unit := BytesBuilder.byte b;
  };

pow {A} {{FromNatural A}} {{Natural A}} : A -> Nat -> A
  | a zero := 1
  | a (suc b) := a * pow a b;

--- 8 byte word
type Word32 := privateMk Nat
with
  fromNat (n : Nat) : Word32 := privateMk n;

  toNat : Word32 -> Nat
    | (privateMk n) := mod n (pow 256 size);

  instance
  FromNat-Word32 : FromNatural Word32 := FromNatural.mkFromNatural fromNat;

  size : Nat := 4;

  instance
  FixedSize-Word32 : FixedSize Word32 := FixedSize.mk size;

  instance
  Show-Word32 : Show Word32 :=
    Show.mk@{
      show : Word32 -> String
        | (privateMk n) := Show.show n;
    };

  instance
  FromBytes-Word32 : FromBytes Word32 := FromBytes.WordN;

  instance
  ToBytes-Word32 : ToBytes Word32 := ToBytes.WordN toNat;
end;

align32 (n : Nat) : Nat :=
  if
    | mod n 32 == 0 := n
    | else := 32 * (div n 32 + 1);

pad32 (n : Nat) : Nat := sub (align32 n) n;

instance
ByteArray-ToBytes : ToBytes ByteArray :=
  ToBytes.mk@{
    toBytes (b : ByteArray) : BytesBuilder Unit :=
      do {
        let
          pad := pad32 (ByteArray.size b);
        in
        ToBytes.toBytes (Word32.fromNat (ByteArray.size b));
        mapA_ ToBytes.toBytes (ByteArray.toList b);
        BytesBuilder.pad pad;
      };
  };

instance
ByteArray-FromBytes : FromBytes ByteArray :=
  FromBytes.mk@{
    fromBytes :=
      do {
        numBytes <- fromBytes {Word32};
        bytes <- replicateA (Word32.toNat numBytes) BytesConsumer.byte;
        pure (ByteArray.fromList bytes);
      };
  };

instance
ToBytes-Bool : ToBytes Bool :=
  ToBytes.mk
    \{
      | false := BytesBuilder.byte 0
      | true := BytesBuilder.byte 1
    };

instance
FromBytes-Bool : FromBytes Bool :=
  FromBytes.mk
    do {
      b <- Byte.toNat <$> BytesConsumer.byte;
      pure (b /= 0);
    };

instance
ToBytes-List {A} {{ToBytes A}} : ToBytes (List A) :=
  ToBytes.mk
    \{l :=
      do {
        let
          len : Word32 := fromNat (length l);
        in
        toBytes len;
        mapA_ toBytes l;
      }};

instance
FromBytes-List {A} {{FromBytes A}} : FromBytes (List A) :=
  FromBytes.mk
    do {
      len <- fromBytes {Word32};
      replicateA (Word32.toNat len) fromBytes;
    };

--- 8 byte integer
type Int32 := privateMk Int
with
  fromInt (n : Int) : Int32 := privateMk n;

  toInt : Int32 -> Int
    | (privateMk n) :=
      case n of
        | Int.ofNat pos := Int.ofNat (mod pos (pow 2 31))
        | Int.negSuc neg := Int.negSuc (mod neg (pow 2 31));

  instance
  FromNat-Int32 : FromNatural Int32 := FromNatural.mkFromNatural fromNat;

  size : Nat := 4;

  instance
  FixedSize-Int32 : FixedSize Int32 := FixedSize.mk size;

  instance
  Show-Int32 : Show Int32 :=
    Show.mk@{
      show : Int32 -> String
        | (privateMk n) := Show.show n;
    };

  instance
  FromBytes-Int32 : FromBytes Int32 :=
    FromBytes.mk
      do {
        w <- Word32.toNat <$> fromBytes;
        if
          | w < pow 2 31 := pure (privateMk (Int.fromNat w))
          | else :=
            let
              subs : Nat := mod w (pow 2 31) + 1;
            in pure (privateMk (Int.negSuc (Nat.sub (pow 2 31) subs)));
      };

  instance
  ToBytes-Int32 : ToBytes Int32 :=
    ToBytes.mk
      \{i :=
        case toInt i of
          | Int.ofNat n := toBytes {Word32} (fromNat n)
          | Int.negSuc n :=
            toBytes {Word32} (fromNat (sub (pow 2 32) (n + 1)))};

  instance
  HasEvmSize-Int32 : HasEvmSize Int32 := HasEvmSize.evmWord;
end;

type EvmSize :=
  | static@{
      numBytes : Nat;
    }
  | dynamic
with
  empty : EvmSize := static 0;

  append : EvmSize -> EvmSize -> EvmSize
    | (static s1) (static s2) := static (s1 + s2)
    | _ _ := dynamic;
end;

trait
type HasEvmSize (T : Type) :=
  mk@{
    evmSizeI : EvmSize;
  }
with
  evmWord {T} {{FixedSize T}} : HasEvmSize T :=
    mk (EvmSize.static evmAlign);

  dynamic {T} : HasEvmSize T := mk EvmSize.dynamic;

  evmSize (T : Type) {{HasEvmSize T}} : EvmSize := evmSizeI {T};
end;

open HasEvmSize using {evmSize; evmSizeI} public;

instance
HasEvmSize-ByteArray : HasEvmSize ByteArray := HasEvmSize.dynamic;

instance
HasEvmSize-Word32 : HasEvmSize Word32 := HasEvmSize.evmWord;

-- TODO abstract over size
--- ByteArray of exactly 32 bytes
type ByteArray32 := ByteArray;

instance
FixedSize-ByteArray32 : FixedSize ByteArray32 := FixedSize.mk 32;

type EvmTuple :=
  | nil : EvmTuple
  | cons
      : {A : Type}
        -> {{HasEvmSize A}}
        -> {{ToBytes A}}
        -> A
        -> EvmTuple
        -> EvmTuple
with
  sizeList : EvmTuple -> List EvmSize :=
    let
      go : List EvmSize -> EvmTuple -> List EvmSize
        | acc EvmTuple.nil := reverse acc
        | acc (cons {_} {{sizeI}} {{_}} x xs) :=
          go (evmSizeI {{sizeI}} :: acc) xs;
    in go [];
end;

headSize : EvmSize -> Nat
  | (EvmSize.static n) := n
  | EvmSize.dynamic := evmAlign;

totalHeadSize : List EvmSize -> Nat := map headSize >> foldl (+) 0;

instance
ToBytes-EvmTuple : ToBytes EvmTuple := ToBytes.mk tupleToBytes;

tupleEvmSize (t : EvmTuple) : EvmSize :=
  let
    go : EvmSize -> EvmTuple -> EvmSize
      | acc EvmTuple.nil := acc
      | acc (EvmTuple.cons {ty} {{_}} {{_}} x xs) :=
        go (EvmSize.append acc (evmSize ty)) xs;
  in go EvmSize.empty t;

tupleToBytes (l : EvmTuple) : BytesBuilder Unit :=
  let
    sizeOfHeads : Nat := totalHeadSize (EvmTuple.sizeList l);
    go (tailBuilder : BytesBuilder.Builder) : EvmTuple -> BytesBuilder Unit
      | EvmTuple.nil := BytesBuilder.builder tailBuilder
      | (EvmTuple.cons {_} {{szI}} {{toBytesI}} x xs) :=
        case evmSizeI {{szI}} of
          | EvmSize.dynamic :=
            let
              offset : Word32 :=
                Word32.fromNat
                  -- headSize EvmSize.dynamic
                    (sizeOfHeads
                    + BytesBuilder.Builder.size tailBuilder);
              tailBuilder' : BytesBuilder.Builder :=
                BytesBuilder.runWith tailBuilder (toBytes x);
            in do {
              toBytes offset;
              go tailBuilder' xs;
            }
          | EvmSize.static _ :=
            do {
              toBytes x;
              go tailBuilder xs;
            };
  in go BytesBuilder.Builder.empty l;

--- splits static objects. Dynamic objects must be parsed after
tupleSplit (l : List EvmSize) : BytesConsumer (List (List Byte)) :=
  let
    go
      (static : List (List Byte))
      : List EvmSize -> BytesConsumer (List (List Byte))
      | [] := pure (reverse static)
      | (x :: xs) :=
        do {
          bs <- replicateA (headSize x) BytesConsumer.byte;
          case x of {
            | EvmSize.static@{} := go (bs :: static) xs
            | EvmSize.dynamic := go static xs
          };
        };
  in go [] l;

type Example : Type :=
  mk@{
    word : Word32;
    bytearray : ByteArray;
    int : Int32;
  };

instance
ToBytes-Example : ToBytes Example :=
  ToBytes.mk@{
    toBytes (e : Example) : BytesBuilder Unit :=
      do {
        let
          tup : EvmTuple :=
            EvmTuple.cons
              (Example.word e)
              (EvmTuple.cons
                (Example.bytearray e)
                (EvmTuple.cons (Example.int e) EvmTuple.nil));
        in
        ToBytes.toBytes tup;
      };
  };

instance
FromBytes-Example : FromBytes Example :=
  FromBytes.mk@{
    fromBytes : BytesConsumer Example :=
      do {
        l <- tupleSplit [evmSize Word32; evmSize ByteArray; evmSize Int32];
        word, bytearray, int <- case l of
                                  | [sword; sint] :=
                                    do {
                                      w <- BytesConsumer.local
                                        FromBytes.fromBytes
                                        sword;
                                      i <- BytesConsumer.local
                                        FromBytes.fromBytes
                                        sint;
                                      b <- FromBytes.fromBytes;
                                      pure (w, b, i);
                                    }
                                  | _ :=
                                    failwith
                                      "FromBytes-Example wrong number of static arguments";
        pure
          Example.mk@{
            word;
            bytearray;
            int;
          };
      };
  };

instance
Show-Example : Show Example :=
  Show.mk@{
    show (e : Example) : String :=
      Show.show (Example.word e)
        ++str ", "
        ++str Show.show (Example.bytearray e)
        ++str ", "
        ++str Show.show (Example.int e);
  };

main : _ :=
  let
    n : List Byte := [3; 4; 5];
    b : ByteArray := ByteArray.mk n;
    i : Int32 := Int32.fromInt 2147483647;
    e : Example :=
      Example.mk@{
        word := Word32.fromNat (sub (pow 256 4) 1);
        bytearray := b;
        int := i;
      };
  in trace (show e)
    >-> trace (show (toByteArray e))
    >-> show (fromByteArray {Example} (toByteArray e));
