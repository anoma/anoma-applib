module Test.Ethereum.Abi;

import Stdlib.Prelude open;
import Test.JuvixUnit open;
import Anoma.Primitives.FixedSize open;
import Ethereum.Abi open;
import Applib open;
import Stdlib.Debug.Fail using {failwith} open;

{-- In order to define ;ToBytes; and ;FromBytes; instances for a
 tuple, we need to follow some mechanical steps.
 This module provides a concrete example. See the comments in the instances
 declarations below.
 --}
module TupleUsageExample;
  type Example : Type :=
    mk@{
      word : UInt32;
      bytearray : ByteArray;
      int : Int256;
      int32 : Int32;
    };

  deriving instance
  Eq-Example : Eq Example;

  {-- To define the ;ToBytes; instance we must create an ;EvmTuple; with the fields
                                      of the record given in order. Then we use the ;ToBytes; instance of the ;EvmTuple;
                                      as shown below.
                                      Note that each of the fields must be an instance of ;ToBytes; and ;HasEvmSize;.
   --}
  instance
  ToBytes-Example : ToBytes Example :=
    ToBytes.mk@{
      toBytes (e : Example) : BytesBuilder Unit :=
        do {
          let
            tup : EvmTuple :=
              Example.word e
                ::: Example.bytearray e
                ::: Example.int e
                ::: Example.int32 e
                ::: EvmTuple.nil;
          in
          ToBytes.toBytes tup;
        };
    };

  {-- To define the ;FromBytes; instance we must follow these steps:
                                  1. call `l <- tupleSplit sizes`, where `sizes` is a list of the ;EvmSize; of
                                     the type of each field.
                                  2. case on `l`. `l` will exactly `n` elements, where `n` is the number
                                     of fields with a type `T` such that `evmSize T` is ;EvmSize.static;
                                  3. For each element `s` of `l`, we call:
                                       `fieldName <- BytesConsumer.local FromBytes.fromBytes s`
                                  4. Then, for each field `f` with a dynamic ;EvmSize;, we call:
                                       `f <- FromBytes.fromBytes`

  For a concrete example, see the code below:
   --}
  instance
  FromBytes-Example : FromBytes Example :=
    FromBytes.mk@{
      fromBytes : BytesConsumer Example :=
        do {
          l <- tupleSplit
            [evmSize UInt32; evmSize ByteArray; evmSize Int256; evmSize Int32];
          case l of {
            | [sword; sint; sint32] :=
              do {
                -- static
                word <- BytesConsumer.local FromBytes.fromBytes sword;
                int <- BytesConsumer.local FromBytes.fromBytes sint;
                int32 <- BytesConsumer.local FromBytes.fromBytes sint32;
                -- dynamic
                bytearray <- FromBytes.fromBytes;
                pure
                  Example.mk@{
                    word;
                    bytearray;
                    int;
                    int32;
                  };
              }
            | _ := failwith "FromBytes-Example wrong number of static arguments"
          };
        };
    };

  instance
  Show-Example : Show Example :=
    Show.mk@{
      show (e : Example) : String :=
        Show.show (Example.word e)
          ++str ", "
          ++str Show.show (Example.bytearray e)
          ++str ", "
          ++str Show.show (Example.int e)
          ++str ", "
          ++str Show.show (Example.int32 e);
    };

  test : TestSuite :=
    TestSuite.group
      "Tuple"
      [
        let
          n : List Byte := [3; 4; 5];
          b : ByteArray := ByteArray.mk n;
          i : Int256 := Int256.fromInt -88888888888888;
          i' : Int32 := Int32.fromInt -2147483647;
          example : Example :=
            Example.mk@{
              word := UInt32.fromNat (sub (pow 256 4) 1);
              bytearray := b;
              int := i;
              int32 := i';
            };
          encodedExample : ByteArray := toByteArray example;
          resDecodedExample : Result BytesConsumer.ConsumerError Example :=
            fromByteArray {Example} encodedExample;
        in testCase "Example" (assertRoundTrip example);
      ];
end;

assertEqualShow {A} {{Eq A}} {{Show A}} (a b : A) : Assertion :=
  assertEqual ("\n" ++str show a ++str "\nnot equal to:\n" ++str show b) a b;

assertRoundTrip
  {A} {{Show A}} {{Eq A}} {{FromBytes A}} {{ToBytes A}} (a : A) : Assertion :=
  let
    encoded : ByteArray := toByteArray a;
    resDecoded : Result BytesConsumer.ConsumerError A := fromByteArray encoded;
  in case resDecoded of
       | error err :=
         Assertion.fail
           ("round trip for '" ++str show a ++str "' failed:\n" ++str show err)
       | ok decoded := assertEqualShow a decoded;

module UIntN;
  test
    (A : Type)
    {{Show A}}
    {{Eq A}}
    {{FixedSize A}}
    {{ToBytes A}}
    {{FromBytes A}}
    {{FromNatural A}}
    (name : String)
    : TestSuite :=
    let
      size := byteSize {A};
      numBits := 8 * size;
    in TestSuite.group
      name
      [
        testCase
          "encode(0)"
          (assertEqualShow
            (toByteArray (fromNat {A} 0))
            (ByteArray.fromList (replicate evmAlign 0)));
        testCase
          ("encode(2 ^ " ++str show numBits ++str ")")
          (assertEqualShow
            (toByteArray (fromNat {A} (pow 256 size)))
            (ByteArray.fromList (replicate evmAlign 0)));
        testCase
          ("encode(2 ^ " ++str show numBits ++str " - 1)")
          (assertEqualShow
            (toByteArray (fromNat {A} (sub (pow 256 size) 1)))
            (ByteArray.fromList
              (replicate (pad32 size) 0 ++ replicate size 255)));
        testCase "decode(encode(0))" (assertRoundTrip {A} 0);
        testCase
          ("decode(encode(2 ^ " ++str show numBits ++str " - 1)")
          (assertRoundTrip (fromNat {A} (sub (pow 256 size) 1)));
      ];
end;

module IntN;
  test
    (A : Type)
    {{Show A}}
    {{Eq A}}
    {{FixedSize A}}
    {{ToBytes A}}
    {{FromBytes A}}
    (fromInt : Int -> A)
    (name : String)
    : TestSuite :=
    let
      size := byteSize {A};
      numBits := 8 * size;
    in TestSuite.group
      name
      [
        testCase
          "encode(0)"
          (assertEqualShow
            (toByteArray (fromInt 0))
            (ByteArray.fromList (replicate evmAlign 0)));
        testCase
          "encode(1)"
          (assertEqualShow
            (toByteArray (fromInt 1))
            (ByteArray.fromList (replicate (sub evmAlign 1) 0 ++ [1])));
        testCase
          "encode(-1)"
          (assertEqualShow
            (toByteArray (fromInt -1))
            (ByteArray.fromList (replicate evmAlign 255)));
        testCase "decode(encode(0))" (assertRoundTrip {A} (fromInt 0));
        testCase
          ("decode(encode(2 ^ " ++str show (sub numBits 1) ++str " - 1)")
          (assertRoundTrip (fromInt (fromNat (sub (pow 2 (sub numBits 1)) 1))));
        testCase
          ("decode(encode(- 2 ^ " ++str show (sub numBits 1) ++str ")")
          (assertRoundTrip (fromInt (fromNat (pow 2 (sub numBits 1)))));
        testCase "decode(encode(1)" (assertRoundTrip (fromInt 1));
        testCase "decode(encode(-1)" (assertRoundTrip (fromInt -1));
      ];
end;

module Bool;
  test : TestSuite :=
    TestSuite.group
      "Bool"
      [
        testCase "true" (assertRoundTrip true);
        testCase "false" (assertRoundTrip false);
      ];
end;

module List;
  test : TestSuite :=
    TestSuite.group
      "List"
      [
        testCase "[]" (assertRoundTrip {List UInt32} []);
        testCase "[1;2;3]" (assertRoundTrip {List UInt32} [1; 2; 3]);
      ];
end;

module ByteArray;
  test : TestSuite :=
    TestSuite.group
      "Dynamic ByteArray"
      [
        testCase "[]" (assertRoundTrip (ByteArray.fromList []));
        testCase "[1;2;3]" (assertRoundTrip (ByteArray.fromList [1; 2; 3]));
      ];
end;

module UInt32;
  test : TestSuite := UIntN.test UInt32 "UInt32";
end;

module UInt256;
  test : TestSuite := UIntN.test UInt256 "UInt256";
end;

module Int32;
  test : TestSuite := IntN.test Int32 Int32.fromInt "Int32";
end;

module Int256;
  test : TestSuite := IntN.test Int256 Int256.fromInt "Int256";
end;

test : TestSuite :=
  TestSuite.group
    "Abi Encoding"
    [
      TupleUsageExample.test;
      UInt32.test;
      UInt256.test;
      Int32.test;
      Int256.test;
      Bool.test;
      List.test;
      ByteArray.test;
    ];
