module Package;

import PackageDescription.V2 open;

package : Package :=
  defaultPackage@{
    name := "anoma-applib";
    version :=
      mkVersion@{
        major := 0;
        minor := 13;
        patch := 1;
      };
    dependencies :=
      [
        github "anoma" "juvix-stdlib" "v0.12.0";
        github "anoma" "juvix-mtl" "v0.3.4";
      ];
  };
